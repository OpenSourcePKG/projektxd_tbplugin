{
  "author": "Pegenau GmbH & Co. KG",
  "background": {
    "scripts": [
      "chrome/background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "projektxd@pegenau.de",
      "strict_max_version": "140.*",
      "strict_min_version": "140.0"
    }
  },
  "default_locale": "de",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "chrome/content/images/projektXD-16.png",
    "32": "chrome/content/images/projektXD-32.png",
    "48": "chrome/content/images/projektXD-48.png",
    "64": "chrome/content/images/projektXD-64.png",
    "96": "chrome/content/images/projektXD-96.png",
    "128": "chrome/content/images/projektXD-128.png"
  },
  "manifest_version": 3,
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_icon": {
      "16": "chrome/content/images/projektXD-16.png",
      "24": "chrome/content/images/projektXD-24.png",
      "32": "chrome/content/images/projektXD-32.png"
    },
    "allowed_spaces": []
  },
  "message_display_action": {
    "default_title": "__MSG_messageActionTitle__",
    "default_icon": {
      "16": "chrome/content/images/projektXD-16.png",
      "24": "chrome/content/images/projektXD-24.png",
      "32": "chrome/content/images/projektXD-32.png"
    }
  },
  "name": "__MSG_extensionName__",
  "options_ui": {
    "browser_style": false,
    "open_in_tab": true,
    "page": "chrome/content/ui/options.html"
  },
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "scripting",
    "messagesRead",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "version": "2.2.1"
}