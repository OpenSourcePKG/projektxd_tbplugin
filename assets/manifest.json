{
  "author": "Pegenau GmbH & Co. KG",
  "background": {
    "scripts": [
      "chrome/background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "projektxd@pegenau.de",
      "strict_max_version": "140.*",
      "strict_min_version": "140.0"
    }
  },
  "default_locale": "de",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "64": "chrome/content/images/projektxd.png"
  },
  "manifest_version": 3,
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_icon": "chrome/content/images/projektxd.png",
    "allowed_spaces": []
  },
  "name": "__MSG_extensionName__",
  "options_ui": {
    "browser_style": false,
    "open_in_tab": true,
    "page": "chrome/content/ui/options.html"
  },
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "version": "2.0.0"
}